[Unit]
Description=Visor, AprilTag vision for the robot
# Not after the network: Visor opens its cameras while the network comes up, and sends to the robot
# once it has a route there.
After=chrony.service
# The robot program puts the program and its configuration in /opt/visor, through Visor's Spotter
# pack (spotter/visor), and restarts it: keep trying for good, including before the first install.
StartLimitIntervalSec=0

[Service]
ExecStart=/opt/visor/visor run --config /opt/visor/visor.toml
Restart=always
RestartSec=1
# The cameras (the video group) are all it needs. The image creates the visor user; /opt/visor is
# Spotter's agent's to write (spotter/visor/README.md), and kept across boots on a read-only root.
User=visor
SupplementaryGroups=video
# Visor's threads on the fast cores of an RK3588 (Orange Pi 5: cores 4-7 are the Cortex-A76s).
CPUAffinity=4-7
Nice=-5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
