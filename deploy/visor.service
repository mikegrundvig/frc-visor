[Unit]
Description=Visor, AprilTag vision for the robot
# Not after the network: Visor opens its cameras while the network comes up, and sends to the robot
# once it has a route there.
After=chrony.service
# The robot program puts the program and its configuration in /opt/visor, through Visor's Spotter
# pack (spotter/visor), and restarts it. Until the robot has written a configuration there are no
# cameras to run, so Visor waits for it rather than restarting every second; the pack's restart after
# configuring starts it. From then on, keep trying for good.
ConditionPathExists=/opt/visor/visor.toml
StartLimitIntervalSec=0

[Service]
ExecStart=/opt/visor/visor run --config /opt/visor/visor.toml
Restart=always
RestartSec=1
# The cameras (the video group) are all it needs. The visor user and /opt/visor, Spotter's agent's
# to write (spotter/visor/README.md), come with this unit in the release's os/ (sysusers.d and
# tmpfiles.d).
User=visor
SupplementaryGroups=video
# /run/visor, the visor user's, readable by anyone, and gone when Visor stops: where it says, as it
# starts, which version and configuration it runs, for its Spotter pack (src/running.rs).
RuntimeDirectory=visor
# Which cores are the fast ones is the board's: its image pins Visor to them with a drop-in
# (CPUAffinity=).
Nice=-5
# Bounds on what a fault or a flood can take from the board. tests/service.rs measures both cameras
# running with the view served: 12 files open (with the test's own) and 34 MB resident at most in a
# debug build (26 MB in a release). The live view takes at most 34 connections at once (32, and 2
# kept for the controller: src/stream/server.rs), so 46 files at most, and 128 is over twice that,
# with room for each camera's device. 256 MB is over seven times the memory: room for each camera's
# frame buffers and every connection's send buffer. tests/service.rs checks these margins.
LimitNOFILE=128
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
