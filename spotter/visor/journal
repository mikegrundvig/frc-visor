#!/bin/sh
# Spotter's catalog journal script (github.com/mikegrundvig/frc-spotter, packs/debian/journal, MIT
# License), its example changed to this pack's service, and journalctl's exit status kept: this
# pack's one copy, as a pack runs only its own files.
# A page of the journal, as journalctl -o json writes it, by what the agent asks in SPOTTER_*:
# SPOTTER_FROM latest (the newest SPOTTER_LIMIT entries), before or after SPOTTER_CURSOR (an
# entry's __CURSOR), oldest first, at SPOTTER_LEVEL or more severe. Its arguments go to journalctl
# as they are: --unit=visor.service, for one service's log. Reading the system journal takes
# the systemd-journal group, which the agent's package gives it.
#
# The auth and authpriv facilities (4 and 10: logins, sudo, sshd, with user names, addresses and
# command lines) are left out, as anyone on the robot's network may page a log; --with-auth, as its
# first argument, keeps them. SPOTTER_* are anyone's too: only ever quoted, never evaluated.
set -u
limit=${SPOTTER_LIMIT:-100}
level=${SPOTTER_LEVEL:-debug}
case $level in
  error) level=err ;;
  warning | info | debug) ;;
  *) level=debug ;;
esac
cursor=${SPOTTER_CURSOR:-}
auth=no
if [ "${1:-}" = --with-auth ]; then
  auth=yes
  shift
fi
set -- -o json --output-fields=MESSAGE,PRIORITY,SYSLOG_IDENTIFIER,SYSLOG_FACILITY --no-pager -q \
  --priority="$level" "$@"

# Lines of the auth facilities left out, unless asked for.
unauth() {
  if [ "$auth" = yes ]; then
    cat
  else
    grep -v -E '"SYSLOG_FACILITY":"(4|10)"'
  fi
}

from=${SPOTTER_FROM:-latest}
case $from in
  latest)
    # Newest first, as many as asked, then oldest first.
    set -- "$@" --reverse
    ;;
  before)
    # Back from the cursor's entry, newest first: that entry left out, then oldest first.
    set -- "$@" --cursor="$cursor" --reverse
    ;;
  after)
    set -- "$@" --after-cursor="$cursor"
    ;;
  *)
    echo "SPOTTER_FROM is latest, before or after, not $from" >&2
    exit 2
    ;;
esac

# journalctl's lines, as the page has them.
page() {
  case $from in
    latest) unauth | head -n "$limit" | tac ;;
    before) grep -v -F -e "$cursor" | unauth | head -n "$limit" | tac ;;
    after) unauth | head -n "$limit" ;;
  esac
}

# journalctl's own exit status, through the pipe, on descriptor 3 (POSIX sh has no pipefail): a
# journal it can't read, or a cursor it refuses, is a failed page, not an empty one. Stopped by
# SIGPIPE (128 + 13) once the page has all it wants is no failure.
exec 4>&1
status=$({ {
  journalctl "$@"
  echo "$?" >&3
} | page >&4; } 3>&1)
case $status in
  0 | 141) ;;
  *) exit "$status" ;;
esac
