#!/bin/sh
# Installs the Visor release on standard input (visor-<version>-linux-arm64.tar.gz): unpacks it
# beside the running one, has the new program say its version (so it runs on this board), and
# only then moves it into place and restarts Visor. A release that won't run leaves the board as
# it was. VISOR_DIR (/opt/visor) and VISOR_RESTART (a program run in place of
# `systemctl restart visor.service`) are for an image laid out otherwise, and tests.
set -eu
dir=${VISOR_DIR:-/opt/visor}
work="$dir/.install"
rm -rf "$work"
mkdir -p "$work"
tar -xzf - -C "$work"
if [ ! -f "$work/visor" ]; then
  echo "the archive has no visor program" >&2
  exit 1
fi
chmod 755 "$work/visor"
# Its own exit status, not a pipe's: a program that fails here must stop the install.
if ! said=$("$work/visor" version 2>&1); then
  echo "the new program doesn't run here: $said" >&2
  exit 1
fi
version=$(echo "$said" | head -n 1)
mv -f "$work/visor" "$dir/visor"
rm -rf "$work"
echo "installed $version" >&2
if [ -n "${VISOR_RESTART:-}" ]; then "$VISOR_RESTART"; else systemctl restart visor.service; fi
printf '{"version": "%s"}\n' "$(echo "$version" | cut -d ' ' -f 2)"
