#!/bin/sh
# Puts the configuration on standard input in place, once the installed Visor's check passes, and
# restarts Visor. A configuration it refuses leaves the board as it was, and says why.
# VISOR_DIR and VISOR_RESTART as for ./install.
set -eu
dir=${VISOR_DIR:-/opt/visor}
cat > "$dir/visor.toml.new"
if ! checked=$("$dir/visor" check --config "$dir/visor.toml.new" 2>&1); then
  echo "Visor refused the configuration: $checked" >&2
  rm -f "$dir/visor.toml.new"
  exit 1
fi
echo "$checked" >&2
mv -f "$dir/visor.toml.new" "$dir/visor.toml"
if [ -n "${VISOR_RESTART:-}" ]; then "$VISOR_RESTART"; else systemctl restart visor.service; fi
printf '{"config": "%s"}\n' "$(sha256sum "$dir/visor.toml" | cut -d ' ' -f 1)"
