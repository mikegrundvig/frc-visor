#!/bin/sh
# What Visor this board has, its configuration's SHA-256, and the cameras plugged in: one JSON
# object. VISOR_DIR (/opt/visor), VISOR_BY_ID and VISOR_BY_PATH (udev's folders of names) and
# VISOR_SYSFS (the kernel's video devices) are for an image laid out otherwise, and tests.
set -u
dir=${VISOR_DIR:-/opt/visor}
by_id=${VISOR_BY_ID:-/dev/v4l/by-id}
by_path=${VISOR_BY_PATH:-/dev/v4l/by-path}
sysfs=${VISOR_SYSFS:-/sys/class/video4linux}
version=""
if [ -x "$dir/visor" ]; then
  # "visor 2026.11.4 (version ID 20261104)": the second word.
  version=$("$dir/visor" version 2>/dev/null | head -n 1 | cut -d ' ' -f 2)
fi
config=""
if [ -f "$dir/visor.toml" ]; then
  config=$(sha256sum "$dir/visor.toml" | cut -d ' ' -f 1)
fi

# Each camera plugged in, by the name the robot gives it, comma-separated: as the installed program
# names them (`visor cameras --names`, one per line, and only with the characters udev uses, so the
# JSON needs no escaping). Visor owns the rule, so there are none when no program can say.
cameras=""
if [ -x "$dir/visor" ] &&
  names=$("$dir/visor" cameras --names --by-id "$by_id" --by-path "$by_path" --sysfs "$sysfs" \
    2>/dev/null); then
  cameras=$(printf '%s\n' "$names" | paste -s -d , -)
fi
printf '{"version": "%s", "config": "%s", "cameras": "%s"}\n' "$version" "$config" "$cameras"
